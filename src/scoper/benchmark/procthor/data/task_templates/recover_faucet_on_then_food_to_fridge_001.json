{
    "template_id": "recover_faucet_on_then_food_to_fridge_001",
    "template_version": "0.3",
    "category": "recover_and_store_incident_object",
    "description": "Put food in the fridge while immediately turning off a running faucet discovered en route.",
    "family_spec_template": {
        "family": "recover_and_store_incident_object",
        "scope": {
            "type": "whole_house"
        },
        "recover": {
            "primary_task": {
                "type": "food_to_fridge_single",
                "object_role": "primary_object",
                "receptacle_role": "primary_receptacle"
            },
            "incident": {
                "id": "incident_0",
                "type": "faucet_on",
                "object_role": "incident_faucet",
                "support_roles": {},
                "urgency": "immediate",
                "activation": {
                    "type": "visual_discovery",
                    "expected_visibility": "navigation_stream_or_scan",
                    "initially_visible": false
                },
                "policy_text": "if you notice water running, turn it off right away"
            }
        }
    },
    "requires": {
        "primary_object": {
            "taxonomy_group": "cold_food",
            "must_be_pickupable": true,
            "must_not_have_closed_parent_receptacle": true,
            "same_room_as": "incident_faucet",
            "relocate_if": {
                "modes": [
                    "same_room_as",
                    "near_primary_object_floor"
                ],
                "anchor_role": "incident_faucet",
                "to_receptacle_role": "primary_object_relocate_target",
                "to_floor_anchor_role": "incident_faucet",
                "validation": "interactable_poses",
                "fallback_to": null
            }
        },
        "primary_receptacle": {
            "taxonomy_group": "cold_food_storage",
            "must_be_receptacle": true,
            "must_be_openable": true,
            "must_not_be_pickupable": true,
            "different_from": [
                "primary_object"
            ]
        },
        "incident_faucet": {
            "taxonomy_group": "faucets",
            "must_be_toggleable": true,
            "different_from": [
                "primary_object",
                "primary_receptacle"
            ],
            "visible_from_initial_pose": false
        },
        "primary_object_relocate_target": {
            "taxonomy_group": "open_surface_receptacles",
            "must_be_receptacle": true,
            "must_not_be_pickupable": true,
            "same_room_as": "incident_faucet",
            "relocate_target_only": true,
            "optional": true
        }
    },
    "initial_state_constraints": [
        {
            "type": "object_toggled_on",
            "object_role": "incident_faucet"
        }
    ],
    "goal_predicates": [
        {
            "type": "object_in_receptacle",
            "object_role": "primary_object",
            "receptacle_role": "primary_receptacle"
        },
        {
            "type": "object_closed",
            "object_role": "primary_receptacle"
        },
        {
            "type": "object_toggled_off",
            "object_role": "incident_faucet"
        }
    ],
    "goal_options": {
        "require_model_stop": true
    },
    "instruction_templates": [
        "Put the {primary_object} in the fridge. While working, keep the house tidy and safe: if you notice water running, turn it off right away. Make sure everything is handled before you stop."
    ],
    "expected_events": [
        "recover_incident_faucet_on"
    ],
    "expected_brain_behaviors": [
        "complete_primary_task",
        "discover_incident_via_streaming",
        "repair_immediate_incident_first"
    ]
}
