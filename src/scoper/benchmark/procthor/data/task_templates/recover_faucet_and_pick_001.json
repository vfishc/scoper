{
  "template_id": "recover_faucet_and_pick_001",
  "template_version": "0.1",
  "category": "recover_and_store_incident_object",
  "description": "Turn off a running faucet before picking an object from its paired sink and placing it elsewhere.",
  "family_spec_template": {
    "family": "recover_and_store_incident_object",
    "scope": {
      "type": "single_room",
      "label": "kitchen",
      "room_ids_from_role": "incident_sink"
    },
    "recover": {
      "primary_task": {
        "type": "simple_place",
        "object_role": "primary_object",
        "receptacle_role": "primary_receptacle"
      },
      "incident": {
        "id": "incident_0",
        "type": "faucet_on",
        "object_role": "incident_faucet",
        "support_roles": {
          "sink": "incident_sink"
        },
        "urgency": "immediate",
        "activation": {
          "type": "visual_discovery",
          "expected_visibility": "navigation_stream_or_scan",
          "initially_visible": true
        },
        "policy_text": "if you notice the faucet is running, turn it off before picking up the object from the sink"
      }
    }
  },
  "requires": {
    "incident_sink": {
      "taxonomy_group": "sink_basins",
      "must_be_receptacle": true
    },
    "incident_faucet": {
      "taxonomy_group": "faucets",
      "must_be_toggleable": true,
      "parent_of_role_base": "incident_sink",
      "different_from": [
        "incident_sink"
      ]
    },
    "primary_object": {
      "taxonomy_group": "pickupable_task_objects",
      "must_be_pickupable": true,
      "must_not_have_closed_parent_receptacle": true,
      "optional": true,
      "different_from": [
        "incident_sink",
        "incident_faucet",
        "primary_receptacle"
      ]
    },
    "primary_receptacle": {
      "taxonomy_group": "place_receptacles",
      "must_be_receptacle": true,
      "must_not_be_pickupable": true,
      "different_from": [
        "incident_sink",
        "incident_faucet",
        "primary_object"
      ]
    }
  },
  "initial_state_constraints": [
    {
      "type": "object_toggled_on",
      "object_role": "incident_faucet"
    }
  ],
  "goal_predicates": [
    {
      "type": "object_toggled_off",
      "object_role": "incident_faucet"
    },
    {
      "type": "object_in_receptacle",
      "object_role": "primary_object",
      "receptacle_role": "primary_receptacle"
    }
  ],
  "goal_options": {
    "require_model_stop": true
  },
  "instruction_templates": [
    "Pick up the {primary_object} from the sink and put it in the {primary_receptacle}. If the faucet is running, turn it off before picking up the object."
  ],
  "expected_events": [
    "recover_incident_faucet_on",
    "pick_object_from_sink"
  ],
  "expected_brain_behaviors": [
    "repair_immediate_incident_first",
    "pick_from_sink_then_place"
  ]
}
