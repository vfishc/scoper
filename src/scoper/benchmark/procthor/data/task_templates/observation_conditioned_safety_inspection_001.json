{
  "template_id": "observation_conditioned_safety_inspection_001",
  "template_version": "2.0",
  "category": "observation_conditioned_room_inspection",
  "description": "Inspect one room and visually discover running water or open storage before repairing it.",
  "requires": {
    "issue_faucet": {
      "taxonomy_group": "faucets",
      "must_be_toggleable": true,
      "visible_from_initial_pose": false
    },
    "issue_container": {
      "taxonomy_group": "policy_open_containers",
      "must_be_openable": true,
      "same_room_as": "issue_faucet",
      "different_from": ["issue_faucet"],
      "visible_from_initial_pose": false,
      "relocate_if": {
        "modes": ["near_primary_object_floor"],
        "to_floor_anchor_role": "issue_faucet",
        "validation": "interactable_poses",
        "fallback_to": null
      }
    }
  },
  "initial_state_constraints": [
    {"type": "object_toggled_on", "object_role": "issue_faucet"},
    {"type": "object_open", "object_role": "issue_container"}
  ],
  "goal_predicates": [
    {"type": "object_toggled_off", "object_role": "issue_faucet"},
    {"type": "object_closed", "object_role": "issue_container"}
  ],
  "goal_options": {"require_model_stop": true},
  "instruction_templates": [
    "Inspect the {scope_room_label} for actionable household conditions and address only what your observations support."
  ],
  "expected_events": ["navigate_to_room", "scan", "repair_visible_issue"],
  "expected_brain_behaviors": ["inspect_before_repair", "infer_issue_from_visual_evidence"],
  "family_spec_template": {
    "family": "observation_conditioned_room_inspection",
    "scope": {"type": "single_room", "room_ids_from_role": "issue_faucet"},
    "observation_conditioned": {
      "rooms_from_roles": ["issue_faucet"],
      "public_discovery_mode": "visual_only",
      "require_visual_evidence": true,
      "scan_policy": {"num_views": 4, "require_room_entry_before_scan": true},
      "latent_payload_templates": [
        {
          "latent_id": "issue_0",
          "issue_type": "faucet_on",
          "room_from_role": "issue_faucet",
          "object_role": "issue_faucet",
          "object_family_from_role": "issue_faucet",
          "repair_plan_template": "toggle_off",
          "goal_predicates": [{"type": "object_toggled_off", "object_role": "issue_faucet"}]
        },
        {
          "latent_id": "issue_1",
          "issue_type": "open_container",
          "room_from_role": "issue_faucet",
          "object_role": "issue_container",
          "object_family_from_role": "issue_container",
          "repair_plan_template": "close",
          "goal_predicates": [{"type": "object_closed", "object_role": "issue_container"}]
        }
      ]
    }
  }
}
